# ── Database (Supabase Postgres) ──────────────────────────────
# Supabase Dashboard → Project Settings → Database:
#   DATABASE_URL = pooled connection string (port 6543, with ?pgbouncer=true)
#   DIRECT_URL   = direct connection string (port 5432) — used by `prisma db push`
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ── Auth ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-random-secret-in-production"
# Local dev: http://localhost:3000 — Production: https://your-domain.vercel.app
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@yourdomain.com"

# ── Social login (optional — leave empty to disable) ─────────────
# Google: https://console.cloud.google.com → Credentials → OAuth client
#   Authorized redirect URI: https://your-domain.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facebook: https://developers.facebook.com → App → Facebook Login
#   Valid OAuth Redirect URI: https://your-domain.vercel.app/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# NOTE: TikTok login button is shown in the UI but needs a custom OAuth
# integration (no official NextAuth provider) before it can be enabled.

# ── Supabase Storage (product image uploads) ─────────────────────
# Supabase Dashboard → Project Settings → API. Create a public bucket
# named "product-images" under Storage first.
SUPABASE_URL="https://[project-ref].supabase.co"
# Service-role key (server-side ONLY — never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=""
# If the two vars above are empty, uploads fall back to local
# public/uploads/ (local dev only — files don't persist on Vercel).
